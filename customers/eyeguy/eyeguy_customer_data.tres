[sub_resource type="Resource" id="Resource_1k7rh"]
script = ExtResource("1_kkj2g")
dialogue_order = PackedStringArray("Good afternoon Human Eye\'m craving a delicous ________ today and Eye hope you can satisfy.", "Eye would like a side of ______ with that actually, and hold the _______.", "Eye\'m not in a rush so no need to be hasty Human. Rushing brings nothing but flaws.", "Don\'t dissapoint, Human.")
