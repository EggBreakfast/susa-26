[sub_resource type="Resource" id="Resource_70s0v"]
script = ExtResource("1_kkj2g")
dialogue_order = PackedStringArray("Hello, Human.", "Eye saw your shop here yesterday as Eye was perceiving the area. It looked interesting Eye might say.", "Eye would like to try your _______ with _______ on top.", "Good luck, Human.")
