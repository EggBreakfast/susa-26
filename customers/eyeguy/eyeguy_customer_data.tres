dialogue_order = PackedStringArray("The weather was pretty dreary outside", "I\'d say I find myself with quite the craving for a stew", "Perhaps a stew with a patty? Or maybe onions would be better. Or maybe two patties...", "Though three patties does sound quite nice.", "Well, give me your best, human.")
