[sub_resource type="Resource" id="Resource_gmb86"]
script = ExtResource("1_rhkhr")
dialogue_order = PackedStringArray("Hello sssssweetie! All thosssssse pesssssky wormssssss are getting under my nervesssssss. No matter how much I tell them off they keep ssssstealing my cropssssssss. I need ssssssome food to help me sssstay full and energized while I build an electric dome around my garden.", "Your menu looks ssssso refresssshing right now I wonder what will be the bessssst for the tassssk ahead? Ah! I know!", "I\'ll have sssssome ______ with a little bit of _______ and a bit of _______ to keep me full for a while.", "Hop to it sssssweettie I\'ll be waiting for my tassssty meal. Try not to dissssapoint.")
dialogue_success = PackedStringArray("Oh thank you ssssssweetie thisssss looksssss delightful!\nIt\'sssssss sssssure to give me the energy I need to ssssstop thosssse pesky wormssssss.", "Once I eat thissssss I\'ll become unsssssstoppable! Muahahaha! MUAHAHAHAHAHA! ENJOY THE ELECTRIC CAGE WORMSSSSS!!!", "...", "Ehhem Thank you ssssweetie.")
dialogue_fail = PackedStringArray("What issss thisssss ugh it looksssss dissssgussssssting! What issssssss wrong with you you vile creature. Your jussssst like thossssse degenerate wormsssssss!", "I hope your resssssturaunt failsssss you atrociousssss ssssscum of earth. I hope every ounce of energy you ssssspent making thissssss meal makessssss you ruin your own gardenssssssss.", "Bye lossssssser!")
