[sub_resource type="Resource" id="Resource_qp3mq"]
script = ExtResource("1_rhkhr")
dialogue_order = PackedStringArray("Hello ssssweetie your food lookssssss ssssso tassssty! I need a meal to fatten up my new husssssband for dinner tomorow! Hesssss ssssuch a ssssweetheart. It\'ssss grosssss. Sssssso letsssss make it ssssavory.", "I want a lot of food to have the bessssst chance of changing that. Thisssss will be a big order sssso be ready! ", "I would like a _______ with a _______ and a sssssside of _______ with extra extra _________!", "Mmm that ssssoundssss deliciousssss I\'m already ssssalivating. Make sssssure you don\'t take too long sssssweetie my hussssssbandsssss waiting!")
dialogue_success = PackedStringArray("Thank you sssssso much thissss looksssssss perfect. My husssssssband isssss going to have the greatesssssst meal of hisssss life.", "I will make ssssure to come back here whenever I need to ssssssstock up on sssssssome more husssssband padding sssssweetie! The caloriesssss alone are killer.", "Take care.")
dialogue_fail = PackedStringArray("What in the world isssss thisssss ssssslop! If I asssssked for a mediocre performance I would have assssssked my hussssband to do it! Thisssss lookssssss like a pile of usssselesssss sssssslop you would feed to literal boat sssscum.", "You are the worsssssst chef that hassssss ever beeen born and you couldn\'t follow directionssssss if they were branded onto your sssssskulll. Thisssss cooking makessssss me want to ssssstarve myssssssself to death.", "You\'re a failure you maggot sssssslime! I hope you end up a rotting messsssss in a pile of ussssselessssss husssskssss of hussssssbandsssss!")
