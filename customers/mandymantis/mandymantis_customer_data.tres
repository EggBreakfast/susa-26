script = ExtResource("1_rhkhr")
dialogue_order = PackedStringArray("Hello ssssweetie! I heard from the lovely cicadas roaming about the night sssssssky that I sssssshouldd try your food. I hope it doessssssn\'t dissssappoint.", "Your menu looksssss delicousssss! Hmm sssssso many optionsssss I wonder what I sssssshould choosssssse. Ah I know!", "I would like a ______ with a sssssweet _________ and a __________.", "Make hassssste sssssweetie I can\'t wait to get home to my husssssband. I\'m pretty sssssshure he expiressssss ssssoon.")
dialogue_success = PackedStringArray("Thank you ssssssssso much it looksssss wonderful! I can\'t wait to enjoy thissssssss with my husssssband! He\'ll make the greatesssssst of ssssaucesssss for my meal!", "I will definitely return again ssssssssweetie! Oh and heressss your pay for the meal. Goodbye now!")
dialogue_fail = PackedStringArray("Thissssss issss HORRIBLE! It\'ssssss not at all what I assssked for you lowlife degenerate. Your cooking sssssssskills are worsssssse than my dead husssssband\'ssss. ", "God I wissssssh I went sssssomewhere elssssse, mabye I would have gotten competent ssssssservice there. Now I have to deal with lugging around a ssssstupid excusssse for a meal. I bet you\'d make a better meal than the sssssssslop you put into otherrsssss mouthssssss.", "You\'re a disssssgusssssting lossssser of a lifeform and I hope you perissssh in the mantisssss uprissssing.")
