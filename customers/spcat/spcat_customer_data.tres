[sub_resource type="Resource" id="Resource_rhye5"]
script = ExtResource("1_djrrr")
dialogue_order = PackedStringArray("Hey guys I\'m starting my livestream of giving food to the homeless. Today we\'re at this place and are gonna get a huge meal for all those in need.", "Hey bruv the homeless want uhh a _______ and a _______ and uhhh a lot of _______ yeah thanks! Oh! Make sure you hold the ________ tho.", "Thanks bruv!")
